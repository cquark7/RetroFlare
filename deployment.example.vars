# Copy to .tmp/deployment.vars and replace the placeholders before deploying.
# One KEY=value per line; ADMIN_EMAILS is optional and comma-separated.
# Choose a Worker name that does not already belong to another application.
# GIPHY is optional; leave its key empty to disable GIF search. This Web SDK key
# is included in the browser bundle, not stored as a Worker secret.
WORKER_NAME=retroflare
ALLOWED_EMAIL_DOMAIN=replace-me.example
ACCESS_TEAM_ISSUER=https://replace-me.cloudflareaccess.com
ACCESS_AUD=replace-me-with-the-access-application-audience
APP_ORIGIN=https://retroflare.example.invalid
ADMIN_EMAILS=
VITE_GIPHY_API_KEY=
